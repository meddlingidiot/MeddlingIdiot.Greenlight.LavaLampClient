<Solution>
  <Folder Name="/build/">
    <!-- Fallout's build host. Part of the solution so it opens and refactors with everything
         else, but never built by the solution: dotnet run builds it itself when a target
         runs, and a solution build that compiled it too would lock its output under a
         running build. -->
    <Project Path="build/_build.csproj">
      <Build Project="false" />
    </Project>
  </Folder>
  <Project Path="Greenlight.LavaLampClient.UnitTests/Greenlight.LavaLampClient.UnitTests.csproj" />
  <Project Path="Greenlight.LavaLampClient/Greenlight.LavaLampClient.csproj" />
</Solution>
